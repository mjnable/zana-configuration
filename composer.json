{
    "name": "mj-zana/configuration",
    "description": "Configuration from PHP files, .env files and the environment, with #[Config] injection",
    "type": "library",
    "keywords": ["zana", "configuration", "config", "dotenv", "environment"],
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "mj-zana/container": "^2.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Zana\\Configuration\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Zana\\Configuration\\Tests\\": "tests/"
        }
    },
    "repositories": [
        { "type": "path", "url": "../zana-container", "options": { "symlink": true, "versions": { "mj-zana/container": "2.3.0" } } }
    ],
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
