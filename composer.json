{
    "name": "zana/configuration",
    "description": "Configuration management with loaders and dot-notation access",
    "type": "library",
    "keywords": ["zana", "configuration", "config", "dot-notation"],
    "license": "MIT",
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Zana\\Configuration\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Zana\\Configuration\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}

